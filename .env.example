# Public canonical URL (used for SEO, sitemap, Open Graph). No trailing slash.
NEXT_PUBLIC_SITE_URL=https://www.hvdtechnologies.com

# Contact form delivery — configure at least one, or submissions will show an error.
# Option 1: Resend (https://resend.com) — emails each lead to your inbox.
RESEND_API_KEY=
CONTACT_TO_EMAIL=           # comma-separated list of recipients
CONTACT_FROM_EMAIL=         # e.g. "HVD Website <website@yourdomain.com>" (domain must be verified in Resend)

# Option 2: any webhook (Zapier, Make, Slack workflow, CRM) — receives the lead as JSON.
CONTACT_WEBHOOK_URL=
